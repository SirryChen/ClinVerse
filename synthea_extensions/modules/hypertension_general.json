{
  "name": "Hypertension General Population",
  "remarks": [
    "Models essential hypertension in the general US population.",
    "Epidemiology: CDC NHANES 2017-2020. ~47% of US adults have hypertension;",
    "blended lifetime-acquisition probability modeled here (men slightly higher",
    "than women until older age, where rates converge).",
    "Supports MIMIC/SICdb conditioning: if person.attributes['mimic_force_hypertension']",
    "is set, disease onset is forced regardless of probability gates.",
    "Treatment follows ACC/AHA 2017 Hypertension Guideline (ACE inhibitor first-line).",
    "SNOMED: 59621000 (Essential hypertension)."
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "direct_transition": "Check_MIMIC_Force"
    },

    "Check_MIMIC_Force": {
      "type": "Simple",
      "remarks": ["Skip age guard if MIMIC/SICdb conditioning forced this condition."],
      "conditional_transition": [
        {
          "transition": "Hypertension_Onset",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "mimic_force_hypertension",
            "operator": "is not nil"
          }
        },
        {
          "transition": "Age_Guard"
        }
      ]
    },

    "Age_Guard": {
      "type": "Guard",
      "allow": {
        "condition_type": "Age",
        "operator": ">=",
        "quantity": 25,
        "unit": "years"
      },
      "direct_transition": "Gender_Split"
    },

    "Gender_Split": {
      "type": "Simple",
      "conditional_transition": [
        {
          "transition": "Male_Onset_Probability",
          "condition": {
            "condition_type": "Gender",
            "gender": "M"
          }
        },
        {
          "transition": "Female_Onset_Probability"
        }
      ]
    },

    "Male_Onset_Probability": {
      "type": "Simple",
      "remarks": ["NHANES: men have higher prevalence than women until ~65."],
      "distributed_transition": [
        { "transition": "Hypertension_Onset", "distribution": 0.47 },
        { "transition": "Terminal", "distribution": 0.53 }
      ]
    },

    "Female_Onset_Probability": {
      "type": "Simple",
      "remarks": ["NHANES: women's rates converge with/exceed men's after menopause."],
      "distributed_transition": [
        { "transition": "Hypertension_Onset", "distribution": 0.43 },
        { "transition": "Terminal", "distribution": 0.57 }
      ]
    },

    "Hypertension_Onset": {
      "type": "ConditionOnset",
      "assign_to_attribute": "hypertension_dx",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "59621000",
          "display": "Essential hypertension (disorder)"
        }
      ],
      "direct_transition": "Hypertension_Encounter"
    },

    "Hypertension_Encounter": {
      "type": "Encounter",
      "encounter_class": "ambulatory",
      "reason": "hypertension_dx",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "185349003",
          "display": "Encounter for check up (procedure)"
        }
      ],
      "direct_transition": "Record_BP"
    },

    "Record_BP": {
      "type": "MultiObservation",
      "category": "vital-signs",
      "codes": [
        {
          "system": "LOINC",
          "code": "85354-9",
          "display": "Blood pressure panel with all children optional"
        }
      ],
      "observations": [
        {
          "category": "vital-signs",
          "vital_sign": "Systolic Blood Pressure",
          "codes": [
            { "system": "LOINC", "code": "8480-6", "display": "Systolic Blood Pressure" }
          ],
          "unit": "mm[Hg]",
          "range": { "low": 145, "high": 175 }
        },
        {
          "category": "vital-signs",
          "vital_sign": "Diastolic Blood Pressure",
          "codes": [
            { "system": "LOINC", "code": "8462-4", "display": "Diastolic Blood Pressure" }
          ],
          "unit": "mm[Hg]",
          "range": { "low": 90, "high": 105 }
        }
      ],
      "direct_transition": "Decide_Treatment"
    },

    "Decide_Treatment": {
      "type": "Simple",
      "remarks": ["ACC/AHA 2017: ACE inhibitor first-line in ~60% of new diagnoses."],
      "distributed_transition": [
        { "transition": "Prescribe_Lisinopril", "distribution": 0.60 },
        { "transition": "Lifestyle_Counseling", "distribution": 0.40 }
      ]
    },

    "Prescribe_Lisinopril": {
      "type": "MedicationOrder",
      "assign_to_attribute": "hypertension_medication",
      "reason": "hypertension_dx",
      "codes": [
        { "system": "RxNorm", "code": "314077", "display": "lisinopril 20 MG Oral Tablet" }
      ],
      "direct_transition": "Encounter_End"
    },

    "Lifestyle_Counseling": {
      "type": "Procedure",
      "reason": "hypertension_dx",
      "codes": [
        { "system": "SNOMED-CT", "code": "281078001", "display": "Education about diet (procedure)" }
      ],
      "duration": { "low": 15, "high": 30, "unit": "minutes" },
      "direct_transition": "Encounter_End"
    },

    "Encounter_End": {
      "type": "EncounterEnd",
      "direct_transition": "Monitoring_Delay"
    },

    "Monitoring_Delay": {
      "type": "Delay",
      "range": { "low": 10, "high": 14, "unit": "months" },
      "direct_transition": "Monitoring_Encounter"
    },

    "Monitoring_Encounter": {
      "type": "Encounter",
      "encounter_class": "ambulatory",
      "reason": "hypertension_dx",
      "wellness": true,
      "codes": [
        { "system": "SNOMED-CT", "code": "185349003", "display": "Encounter for check up (procedure)" }
      ],
      "direct_transition": "Monitoring_BP"
    },

    "Monitoring_BP": {
      "type": "MultiObservation",
      "category": "vital-signs",
      "codes": [
        { "system": "LOINC", "code": "85354-9", "display": "Blood pressure panel with all children optional" }
      ],
      "observations": [
        {
          "category": "vital-signs",
          "vital_sign": "Systolic Blood Pressure",
          "codes": [
            { "system": "LOINC", "code": "8480-6", "display": "Systolic Blood Pressure" }
          ],
          "unit": "mm[Hg]",
          "range": { "low": 120, "high": 140 }
        },
        {
          "category": "vital-signs",
          "vital_sign": "Diastolic Blood Pressure",
          "codes": [
            { "system": "LOINC", "code": "8462-4", "display": "Diastolic Blood Pressure" }
          ],
          "unit": "mm[Hg]",
          "range": { "low": 75, "high": 88 }
        }
      ],
      "direct_transition": "Monitoring_End"
    },

    "Monitoring_End": {
      "type": "EncounterEnd",
      "direct_transition": "Monitoring_Delay"
    },

    "Terminal": {
      "type": "Terminal"
    }
  }
}
