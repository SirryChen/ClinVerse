{
  "name": "Type 2 Diabetes General Population",
  "remarks": [
    "Models type 2 diabetes mellitus in the general US population.",
    "Epidemiology: CDC National Diabetes Statistics Report. ~11.6% of US adults",
    "have diagnosed diabetes; blended lifetime-acquisition probability modeled here.",
    "Supports MIMIC/SICdb conditioning: if person.attributes['mimic_force_diabetes']",
    "is set, disease onset is forced regardless of probability gates.",
    "Treatment follows ADA Standards of Care (metformin first-line).",
    "SNOMED: 44054006 (Diabetes mellitus type 2)."
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "direct_transition": "Check_MIMIC_Force"
    },

    "Check_MIMIC_Force": {
      "type": "Simple",
      "remarks": ["Skip age guard if MIMIC/SICdb conditioning forced this condition."],
      "conditional_transition": [
        {
          "transition": "Diabetes_Onset",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "mimic_force_diabetes",
            "operator": "is not nil"
          }
        },
        {
          "transition": "Age_Guard"
        }
      ]
    },

    "Age_Guard": {
      "type": "Guard",
      "allow": {
        "condition_type": "Age",
        "operator": ">=",
        "quantity": 25,
        "unit": "years"
      },
      "direct_transition": "Gender_Split"
    },

    "Gender_Split": {
      "type": "Simple",
      "conditional_transition": [
        {
          "transition": "Male_Onset_Probability",
          "condition": {
            "condition_type": "Gender",
            "gender": "M"
          }
        },
        {
          "transition": "Female_Onset_Probability"
        }
      ]
    },

    "Male_Onset_Probability": {
      "type": "Simple",
      "remarks": ["CDC: men slightly higher diagnosed prevalence than women."],
      "distributed_transition": [
        { "transition": "Diabetes_Onset", "distribution": 0.12 },
        { "transition": "Terminal", "distribution": 0.88 }
      ]
    },

    "Female_Onset_Probability": {
      "type": "Simple",
      "remarks": ["CDC: women slightly lower diagnosed prevalence than men."],
      "distributed_transition": [
        { "transition": "Diabetes_Onset", "distribution": 0.10 },
        { "transition": "Terminal", "distribution": 0.90 }
      ]
    },

    "Diabetes_Onset": {
      "type": "ConditionOnset",
      "assign_to_attribute": "diabetes_dx",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "44054006",
          "display": "Diabetes mellitus type 2 (disorder)"
        }
      ],
      "direct_transition": "Diabetes_Encounter"
    },

    "Diabetes_Encounter": {
      "type": "Encounter",
      "encounter_class": "ambulatory",
      "reason": "diabetes_dx",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "185349003",
          "display": "Encounter for check up (procedure)"
        }
      ],
      "direct_transition": "Record_HbA1c"
    },

    "Record_HbA1c": {
      "type": "DiagnosticReport",
      "codes": [
        { "system": "LOINC", "code": "4548-4", "display": "Hemoglobin A1c/Hemoglobin.total in Blood" }
      ],
      "observations": [
        {
          "category": "laboratory",
          "codes": [
            { "system": "LOINC", "code": "4548-4", "display": "Hemoglobin A1c/Hemoglobin.total in Blood" }
          ],
          "unit": "%",
          "range": { "low": 7.5, "high": 9.5 }
        }
      ],
      "direct_transition": "Decide_Treatment"
    },

    "Decide_Treatment": {
      "type": "Simple",
      "remarks": ["ADA: metformin first-line in ~70% of new diagnoses unless contraindicated."],
      "distributed_transition": [
        { "transition": "Prescribe_Metformin", "distribution": 0.70 },
        { "transition": "Lifestyle_Counseling", "distribution": 0.30 }
      ]
    },

    "Prescribe_Metformin": {
      "type": "MedicationOrder",
      "assign_to_attribute": "diabetes_medication",
      "reason": "diabetes_dx",
      "codes": [
        {
          "system": "RxNorm",
          "code": "860975",
          "display": "24 HR Metformin hydrochloride 500 MG Extended Release Oral Tablet"
        }
      ],
      "direct_transition": "Encounter_End"
    },

    "Lifestyle_Counseling": {
      "type": "Procedure",
      "reason": "diabetes_dx",
      "codes": [
        { "system": "SNOMED-CT", "code": "281078001", "display": "Education about diet (procedure)" }
      ],
      "duration": { "low": 15, "high": 30, "unit": "minutes" },
      "direct_transition": "Encounter_End"
    },

    "Encounter_End": {
      "type": "EncounterEnd",
      "direct_transition": "Monitoring_Delay"
    },

    "Monitoring_Delay": {
      "type": "Delay",
      "range": { "low": 3, "high": 6, "unit": "months" },
      "direct_transition": "Monitoring_Encounter"
    },

    "Monitoring_Encounter": {
      "type": "Encounter",
      "encounter_class": "ambulatory",
      "reason": "diabetes_dx",
      "wellness": true,
      "codes": [
        { "system": "SNOMED-CT", "code": "185349003", "display": "Encounter for check up (procedure)" }
      ],
      "direct_transition": "Monitoring_HbA1c"
    },

    "Monitoring_HbA1c": {
      "type": "DiagnosticReport",
      "codes": [
        { "system": "LOINC", "code": "4548-4", "display": "Hemoglobin A1c/Hemoglobin.total in Blood" }
      ],
      "observations": [
        {
          "category": "laboratory",
          "codes": [
            { "system": "LOINC", "code": "4548-4", "display": "Hemoglobin A1c/Hemoglobin.total in Blood" }
          ],
          "unit": "%",
          "range": { "low": 6.5, "high": 7.5 }
        }
      ],
      "direct_transition": "Monitoring_End"
    },

    "Monitoring_End": {
      "type": "EncounterEnd",
      "direct_transition": "Monitoring_Delay"
    },

    "Terminal": {
      "type": "Terminal"
    }
  }
}
