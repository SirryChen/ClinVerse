{
  "name": "Hyperlipidemia General Population",
  "remarks": [
    "Models hyperlipidemia (high cholesterol/triglycerides) in the general US population.",
    "Epidemiology: CDC NHANES 2017-2020. ~11.5% age-adjusted prevalence of total cholesterol >= 240 mg/dL.",
    "Age-stratified onset rates based on NHANES data (Virani SS et al., Circulation 2021).",
    "Supports MIMIC conditioning: if person.attributes['mimic_force_hyperlipidemia'] is set,",
    "disease onset is forced regardless of probability gates.",
    "Treatment follows ACC/AHA 2019 Guideline on Primary Prevention of CVD.",
    "SNOMED: 55822004 (Hyperlipidemia), 13644009 (Hypercholesterolemia).",
    "Medications: RxNorm codes for atorvastatin, simvastatin, rosuvastatin, ezetimibe."
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "direct_transition": "Check_MIMIC_Force"
    },

    "Check_MIMIC_Force": {
      "type": "Simple",
      "remarks": ["Skip age guard if MIMIC conditioning forced this condition."],
      "conditional_transition": [
        {
          "transition": "Hyperlipidemia_Onset",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "mimic_force_hyperlipidemia",
            "operator": "is not nil"
          }
        },
        {
          "transition": "Age_Guard"
        }
      ]
    },

    "Age_Guard": {
      "type": "Guard",
      "allow": {
        "condition_type": "Age",
        "operator": ">=",
        "quantity": 30,
        "unit": "years"
      },
      "direct_transition": "Gender_Split"
    },

    "Gender_Split": {
      "type": "Simple",
      "conditional_transition": [
        {
          "transition": "Male_Onset_Probability",
          "condition": {
            "condition_type": "Gender",
            "gender": "M"
          }
        },
        {
          "transition": "Female_Onset_Probability"
        }
      ]
    },

    "Male_Onset_Probability": {
      "type": "Simple",
      "remarks": [
        "NHANES 2017-2020: age-stratified male prevalence.",
        "30-44: ~10%, 45-64: ~18%, 65+: ~19%. We model annual incidence approximation.",
        "Distribution sums to ~18% cumulative onset between 30-80 (lifetime)."
      ],
      "distributed_transition": [
        {
          "transition": "Hyperlipidemia_Onset",
          "distribution": 0.18
        },
        {
          "transition": "Terminal",
          "distribution": 0.82
        }
      ]
    },

    "Female_Onset_Probability": {
      "type": "Simple",
      "remarks": [
        "NHANES 2017-2020: women 45-64 have higher rates (~20%) post-menopause.",
        "Overall female lifetime prevalence ~19%."
      ],
      "distributed_transition": [
        {
          "transition": "Hyperlipidemia_Onset",
          "distribution": 0.19
        },
        {
          "transition": "Terminal",
          "distribution": 0.81
        }
      ]
    },

    "Hyperlipidemia_Onset": {
      "type": "ConditionOnset",
      "assign_to_attribute": "hyperlipidemia_dx",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "55822004",
          "display": "Hyperlipidemia (disorder)"
        }
      ],
      "direct_transition": "Hyperlipidemia_Encounter"
    },

    "Hyperlipidemia_Encounter": {
      "type": "Encounter",
      "encounter_class": "ambulatory",
      "reason": "hyperlipidemia_dx",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "185349003",
          "display": "Encounter for check up (procedure)"
        }
      ],
      "direct_transition": "Record_LipidPanel"
    },

    "Record_LipidPanel": {
      "type": "DiagnosticReport",
      "codes": [
        {
          "system": "LOINC",
          "code": "57698-3",
          "display": "Lipid panel with direct LDL - Serum or Plasma"
        }
      ],
      "observations": [
        {
          "category": "laboratory",
          "vital_sign": "Total Cholesterol",
          "codes": [
            {
              "system": "LOINC",
              "code": "2093-3",
              "display": "Cholesterol [Mass/volume] in Serum or Plasma"
            }
          ],
          "unit": "mg/dL",
          "range": { "low": 215, "high": 295 }
        },
        {
          "category": "laboratory",
          "codes": [
            {
              "system": "LOINC",
              "code": "2571-8",
              "display": "Triglycerides [Mass/volume] in Serum or Plasma"
            }
          ],
          "unit": "mg/dL",
          "range": { "low": 150, "high": 350 }
        },
        {
          "category": "laboratory",
          "vital_sign": "LDL Cholesterol",
          "codes": [
            {
              "system": "LOINC",
              "code": "18262-6",
              "display": "LDL Cholesterol [Mass/volume] in Serum by Direct assay"
            }
          ],
          "unit": "mg/dL",
          "range": { "low": 130, "high": 210 }
        },
        {
          "category": "laboratory",
          "vital_sign": "HDL Cholesterol",
          "codes": [
            {
              "system": "LOINC",
              "code": "2085-9",
              "display": "Cholesterol in HDL [Mass/volume] in Serum or Plasma"
            }
          ],
          "unit": "mg/dL",
          "range": { "low": 30, "high": 55 }
        }
      ],
      "direct_transition": "Decide_Statin"
    },

    "Decide_Statin": {
      "type": "Simple",
      "remarks": [
        "ACC/AHA 2019: statin therapy in ~65% of newly diagnosed hyperlipidemia patients.",
        "Remainder managed with lifestyle modification alone initially."
      ],
      "distributed_transition": [
        {
          "transition": "Prescribe_Atorvastatin",
          "distribution": 0.45
        },
        {
          "transition": "Prescribe_Rosuvastatin",
          "distribution": 0.15
        },
        {
          "transition": "Prescribe_Simvastatin",
          "distribution": 0.10
        },
        {
          "transition": "Lifestyle_Counseling",
          "distribution": 0.30
        }
      ]
    },

    "Prescribe_Atorvastatin": {
      "type": "MedicationOrder",
      "assign_to_attribute": "statin_medication",
      "reason": "hyperlipidemia_dx",
      "codes": [
        {
          "system": "RxNorm",
          "code": "617311",
          "display": "Atorvastatin 40 MG Oral Tablet"
        }
      ],
      "direct_transition": "Encounter_End"
    },

    "Prescribe_Rosuvastatin": {
      "type": "MedicationOrder",
      "assign_to_attribute": "statin_medication",
      "reason": "hyperlipidemia_dx",
      "codes": [
        {
          "system": "RxNorm",
          "code": "904458",
          "display": "Rosuvastatin calcium 20 MG Oral Tablet"
        }
      ],
      "direct_transition": "Encounter_End"
    },

    "Prescribe_Simvastatin": {
      "type": "MedicationOrder",
      "assign_to_attribute": "statin_medication",
      "reason": "hyperlipidemia_dx",
      "codes": [
        {
          "system": "RxNorm",
          "code": "312961",
          "display": "Simvastatin 40 MG Oral Tablet"
        }
      ],
      "direct_transition": "Encounter_End"
    },

    "Lifestyle_Counseling": {
      "type": "Procedure",
      "reason": "hyperlipidemia_dx",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "281078001",
          "display": "Education about diet (procedure)"
        }
      ],
      "duration": { "low": 15, "high": 30, "unit": "minutes" },
      "direct_transition": "Encounter_End"
    },

    "Encounter_End": {
      "type": "EncounterEnd",
      "direct_transition": "Follow_Up_Delay"
    },

    "Follow_Up_Delay": {
      "type": "Delay",
      "range": { "low": 3, "high": 12, "unit": "months" },
      "direct_transition": "Follow_Up_Encounter"
    },

    "Follow_Up_Encounter": {
      "type": "Encounter",
      "encounter_class": "ambulatory",
      "reason": "hyperlipidemia_dx",
      "wellness": true,
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "185349003",
          "display": "Encounter for check up (procedure)"
        }
      ],
      "direct_transition": "Follow_Up_Lipid_Panel"
    },

    "Follow_Up_Lipid_Panel": {
      "type": "DiagnosticReport",
      "codes": [
        {
          "system": "LOINC",
          "code": "57698-3",
          "display": "Lipid panel with direct LDL - Serum or Plasma"
        }
      ],
      "observations": [
        {
          "category": "laboratory",
          "vital_sign": "Total Cholesterol",
          "codes": [
            {
              "system": "LOINC",
              "code": "2093-3",
              "display": "Cholesterol [Mass/volume] in Serum or Plasma"
            }
          ],
          "unit": "mg/dL",
          "range": { "low": 170, "high": 250 }
        },
        {
          "category": "laboratory",
          "vital_sign": "LDL Cholesterol",
          "codes": [
            {
              "system": "LOINC",
              "code": "18262-6",
              "display": "LDL Cholesterol [Mass/volume] in Serum by Direct assay"
            }
          ],
          "unit": "mg/dL",
          "range": { "low": 80, "high": 160 }
        },
        {
          "category": "laboratory",
          "vital_sign": "HDL Cholesterol",
          "codes": [
            {
              "system": "LOINC",
              "code": "2085-9",
              "display": "Cholesterol in HDL [Mass/volume] in Serum or Plasma"
            }
          ],
          "unit": "mg/dL",
          "range": { "low": 35, "high": 65 }
        }
      ],
      "direct_transition": "Follow_Up_End"
    },

    "Follow_Up_End": {
      "type": "EncounterEnd",
      "direct_transition": "Annual_Monitoring_Delay"
    },

    "Annual_Monitoring_Delay": {
      "type": "Delay",
      "range": { "low": 10, "high": 14, "unit": "months" },
      "direct_transition": "Annual_Monitoring"
    },

    "Annual_Monitoring": {
      "type": "Encounter",
      "encounter_class": "ambulatory",
      "reason": "hyperlipidemia_dx",
      "wellness": true,
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "185349003",
          "display": "Encounter for check up (procedure)"
        }
      ],
      "direct_transition": "Annual_Lipid_Panel"
    },

    "Annual_Lipid_Panel": {
      "type": "DiagnosticReport",
      "codes": [
        {
          "system": "LOINC",
          "code": "57698-3",
          "display": "Lipid panel with direct LDL - Serum or Plasma"
        }
      ],
      "observations": [
        {
          "category": "laboratory",
          "vital_sign": "Total Cholesterol",
          "codes": [
            {
              "system": "LOINC",
              "code": "2093-3",
              "display": "Cholesterol [Mass/volume] in Serum or Plasma"
            }
          ],
          "unit": "mg/dL",
          "range": { "low": 155, "high": 235 }
        },
        {
          "category": "laboratory",
          "vital_sign": "LDL Cholesterol",
          "codes": [
            {
              "system": "LOINC",
              "code": "18262-6",
              "display": "LDL Cholesterol [Mass/volume] in Serum by Direct assay"
            }
          ],
          "unit": "mg/dL",
          "range": { "low": 65, "high": 140 }
        }
      ],
      "direct_transition": "Annual_End"
    },

    "Annual_End": {
      "type": "EncounterEnd",
      "direct_transition": "Annual_Monitoring_Delay"
    },

    "Terminal": {
      "type": "Terminal"
    }
  }
}
