{
  "name": "Chronic Kidney Disease General Population",
  "remarks": [
    "Models chronic kidney disease (CKD) in the general US population, modeled",
    "at stage 3 onset (the most common diagnosed stage), with a minority",
    "progressing to stage 4 or end-stage renal disease at follow-up.",
    "Epidemiology: CDC ~7% of US adults have diagnosed CKD; rare before age 40.",
    "Supports MIMIC/SICdb conditioning: if person.attributes['mimic_force_ckd']",
    "is set, disease onset is forced regardless of probability gates.",
    "SNOMED: 433144002 (CKD stage 3), 431857002 (CKD stage 4),",
    "46177005 (end-stage renal disease)."
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "direct_transition": "Check_MIMIC_Force"
    },

    "Check_MIMIC_Force": {
      "type": "Simple",
      "remarks": ["Skip age guard if MIMIC/SICdb conditioning forced this condition."],
      "conditional_transition": [
        {
          "transition": "CKD3_Onset",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "mimic_force_ckd",
            "operator": "is not nil"
          }
        },
        {
          "transition": "Age_Guard"
        }
      ]
    },

    "Age_Guard": {
      "type": "Guard",
      "allow": {
        "condition_type": "Age",
        "operator": ">=",
        "quantity": 40,
        "unit": "years"
      },
      "direct_transition": "Onset_Probability"
    },

    "Onset_Probability": {
      "type": "Simple",
      "remarks": ["CDC: ~7% of adults 40+ have diagnosed CKD."],
      "distributed_transition": [
        { "transition": "CKD3_Onset", "distribution": 0.07 },
        { "transition": "Terminal", "distribution": 0.93 }
      ]
    },

    "CKD3_Onset": {
      "type": "ConditionOnset",
      "assign_to_attribute": "ckd_dx",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "433144002",
          "display": "Chronic kidney disease stage 3 (disorder)"
        }
      ],
      "direct_transition": "CKD_Encounter"
    },

    "CKD_Encounter": {
      "type": "Encounter",
      "encounter_class": "ambulatory",
      "reason": "ckd_dx",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "185349003",
          "display": "Encounter for check up (procedure)"
        }
      ],
      "direct_transition": "Record_Renal_Labs"
    },

    "Record_Renal_Labs": {
      "type": "MultiObservation",
      "category": "laboratory",
      "codes": [
        { "system": "LOINC", "code": "24362-6", "display": "Renal function panel" }
      ],
      "observations": [
        {
          "category": "laboratory",
          "vital_sign": "Creatinine",
          "codes": [
            { "system": "LOINC", "code": "2160-0", "display": "Creatinine [Mass/volume] in Serum or Plasma" }
          ],
          "unit": "mg/dL",
          "range": { "low": 1.5, "high": 2.5 }
        },
        {
          "category": "laboratory",
          "vital_sign": "EGFR",
          "codes": [
            {
              "system": "LOINC",
              "code": "33914-3",
              "display": "Glomerular filtration rate [Volume Rate/Area] in Serum or Plasma by Creatinine-based formula (MDRD)/1.73 sq M"
            }
          ],
          "unit": "mL/min/{1.73_m2}",
          "range": { "low": 30, "high": 55 }
        }
      ],
      "direct_transition": "Prescribe_ACE_Inhibitor"
    },

    "Prescribe_ACE_Inhibitor": {
      "type": "MedicationOrder",
      "assign_to_attribute": "ckd_medication",
      "reason": "ckd_dx",
      "remarks": ["ACE inhibitors are renal-protective and standard of care for CKD with proteinuria."],
      "codes": [
        { "system": "RxNorm", "code": "314077", "display": "lisinopril 20 MG Oral Tablet" }
      ],
      "direct_transition": "Encounter_End"
    },

    "Encounter_End": {
      "type": "EncounterEnd",
      "direct_transition": "Monitoring_Delay"
    },

    "Monitoring_Delay": {
      "type": "Delay",
      "range": { "low": 6, "high": 12, "unit": "months" },
      "direct_transition": "Monitoring_Encounter"
    },

    "Monitoring_Encounter": {
      "type": "Encounter",
      "encounter_class": "ambulatory",
      "reason": "ckd_dx",
      "wellness": true,
      "codes": [
        { "system": "SNOMED-CT", "code": "185349003", "display": "Encounter for check up (procedure)" }
      ],
      "direct_transition": "Monitoring_Renal_Labs"
    },

    "Monitoring_Renal_Labs": {
      "type": "MultiObservation",
      "category": "laboratory",
      "codes": [
        { "system": "LOINC", "code": "24362-6", "display": "Renal function panel" }
      ],
      "observations": [
        {
          "category": "laboratory",
          "vital_sign": "Creatinine",
          "codes": [
            { "system": "LOINC", "code": "2160-0", "display": "Creatinine [Mass/volume] in Serum or Plasma" }
          ],
          "unit": "mg/dL",
          "range": { "low": 1.5, "high": 2.8 }
        },
        {
          "category": "laboratory",
          "vital_sign": "EGFR",
          "codes": [
            {
              "system": "LOINC",
              "code": "33914-3",
              "display": "Glomerular filtration rate [Volume Rate/Area] in Serum or Plasma by Creatinine-based formula (MDRD)/1.73 sq M"
            }
          ],
          "unit": "mL/min/{1.73_m2}",
          "range": { "low": 25, "high": 55 }
        }
      ],
      "direct_transition": "Decide_Progression"
    },

    "Decide_Progression": {
      "type": "Simple",
      "remarks": ["Most stage-3 CKD remains stable for years; a minority progresses per follow-up."],
      "distributed_transition": [
        { "transition": "Progress_To_Stage4", "distribution": 0.10 },
        { "transition": "Monitoring_End", "distribution": 0.90 }
      ]
    },

    "Progress_To_Stage4": {
      "type": "ConditionOnset",
      "assign_to_attribute": "ckd_dx",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "431857002",
          "display": "Chronic kidney disease stage 4 (disorder)"
        }
      ],
      "direct_transition": "Monitoring_End"
    },

    "Monitoring_End": {
      "type": "EncounterEnd",
      "direct_transition": "Monitoring_Delay"
    },

    "Terminal": {
      "type": "Terminal"
    }
  }
}
