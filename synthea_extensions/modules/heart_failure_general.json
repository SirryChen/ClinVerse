{
  "name": "Heart Failure General Population",
  "remarks": [
    "Models chronic congestive heart failure in the general US population.",
    "Epidemiology: CDC/AHA ~2.5% of US adults overall, rising sharply with age;",
    "blended lifetime-acquisition probability modeled here, gated to age 45+.",
    "Supports MIMIC/SICdb conditioning: if person.attributes['mimic_force_heart_failure']",
    "is set, disease onset is forced regardless of probability gates.",
    "Treatment follows ACC/AHA/HFSA 2022 guideline-directed medical therapy:",
    "ACE inhibitor/ARB + beta-blocker + loop diuretic for volume control.",
    "SNOMED: 88805009 (Chronic congestive heart failure)."
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "direct_transition": "Check_MIMIC_Force"
    },

    "Check_MIMIC_Force": {
      "type": "Simple",
      "remarks": ["Skip age guard if MIMIC/SICdb conditioning forced this condition."],
      "conditional_transition": [
        {
          "transition": "Heart_Failure_Onset",
          "condition": {
            "condition_type": "Attribute",
            "attribute": "mimic_force_heart_failure",
            "operator": "is not nil"
          }
        },
        {
          "transition": "Age_Guard"
        }
      ]
    },

    "Age_Guard": {
      "type": "Guard",
      "allow": {
        "condition_type": "Age",
        "operator": ">=",
        "quantity": 45,
        "unit": "years"
      },
      "direct_transition": "Onset_Probability"
    },

    "Onset_Probability": {
      "type": "Simple",
      "remarks": ["CDC/AHA: ~2.5-3% of adults 45+ have diagnosed heart failure, rising with age."],
      "distributed_transition": [
        { "transition": "Heart_Failure_Onset", "distribution": 0.03 },
        { "transition": "Terminal", "distribution": 0.97 }
      ]
    },

    "Heart_Failure_Onset": {
      "type": "ConditionOnset",
      "assign_to_attribute": "heart_failure_dx",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "88805009",
          "display": "Chronic congestive heart failure (disorder)"
        }
      ],
      "direct_transition": "Heart_Failure_Encounter"
    },

    "Heart_Failure_Encounter": {
      "type": "Encounter",
      "encounter_class": "ambulatory",
      "reason": "heart_failure_dx",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "185349003",
          "display": "Encounter for check up (procedure)"
        }
      ],
      "direct_transition": "Record_LVEF"
    },

    "Record_LVEF": {
      "type": "Observation",
      "category": "laboratory",
      "vital_sign": "Left ventricular Ejection fraction",
      "codes": [
        { "system": "LOINC", "code": "10230-1", "display": "Left ventricular Ejection fraction" }
      ],
      "unit": "%",
      "range": { "low": 30, "high": 45 },
      "direct_transition": "Prescribe_ACE_Inhibitor"
    },

    "Prescribe_ACE_Inhibitor": {
      "type": "MedicationOrder",
      "assign_to_attribute": "heart_failure_medication_ace",
      "reason": "heart_failure_dx",
      "codes": [
        { "system": "RxNorm", "code": "314077", "display": "lisinopril 20 MG Oral Tablet" }
      ],
      "direct_transition": "Prescribe_Beta_Blocker"
    },

    "Prescribe_Beta_Blocker": {
      "type": "MedicationOrder",
      "assign_to_attribute": "heart_failure_medication_bb",
      "reason": "heart_failure_dx",
      "codes": [
        { "system": "RxNorm", "code": "200033", "display": "carvedilol 25 MG Oral Tablet" }
      ],
      "direct_transition": "Prescribe_Diuretic"
    },

    "Prescribe_Diuretic": {
      "type": "MedicationOrder",
      "assign_to_attribute": "heart_failure_medication_diuretic",
      "reason": "heart_failure_dx",
      "codes": [
        { "system": "RxNorm", "code": "313988", "display": "Furosemide 40 MG Oral Tablet" }
      ],
      "direct_transition": "Encounter_End"
    },

    "Encounter_End": {
      "type": "EncounterEnd",
      "direct_transition": "Monitoring_Delay"
    },

    "Monitoring_Delay": {
      "type": "Delay",
      "range": { "low": 3, "high": 6, "unit": "months" },
      "direct_transition": "Monitoring_Encounter"
    },

    "Monitoring_Encounter": {
      "type": "Encounter",
      "encounter_class": "ambulatory",
      "reason": "heart_failure_dx",
      "wellness": true,
      "codes": [
        { "system": "SNOMED-CT", "code": "185349003", "display": "Encounter for check up (procedure)" }
      ],
      "direct_transition": "Monitoring_LVEF"
    },

    "Monitoring_LVEF": {
      "type": "Observation",
      "category": "laboratory",
      "vital_sign": "Left ventricular Ejection fraction",
      "codes": [
        { "system": "LOINC", "code": "10230-1", "display": "Left ventricular Ejection fraction" }
      ],
      "unit": "%",
      "range": { "low": 30, "high": 50 },
      "direct_transition": "Monitoring_End"
    },

    "Monitoring_End": {
      "type": "EncounterEnd",
      "direct_transition": "Monitoring_Delay"
    },

    "Terminal": {
      "type": "Terminal"
    }
  }
}
